    "@deck.gl/geo-layers": "9.1.15",
    "@deck.gl/layers": "9.1.15",
    "@deck.gl/mesh-layers": "9.1.15",
    "@deck.gl/react": "9.1.15",
    "@deck.gl/widgets": "9.1.15",
    "@loaders.gl/terrain": "4.5.2",
    "mapbox-gl": "3.15.0",
    "maplibre-gl": "5.9.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-map-gl": "8.0.4",
    "recharts": "2.15.4"
