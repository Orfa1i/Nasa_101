# FastAPI backend that Next proxies /api/* to (server side).
LITHOCREEP_API_URL=http://127.0.0.1:8000
# Optional: Mapbox token. Without it the map uses MapLibre GL, CARTO basemap tiles and
# AWS Terrain Tiles (Terrarium); with it, Mapbox GL, Mapbox satellite and Mapbox terrain-RGB.
MAPBOX_ACCESS_TOKEN=
# Optional overrides
# NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
